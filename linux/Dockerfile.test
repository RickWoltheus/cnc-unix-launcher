FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl file binutils lib32gcc-s1 lib32stdc++6 libglib2.0-0 libegl1 libgl1 \
    libdbus-1-3 libxkbcommon0 libfontconfig1 libxcb-cursor0 libx11-xcb1 \
    libxkbcommon-x11-0 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 libxcb-xkb1 \
    libgtk-3-0 xvfb xauth \
    && rm -rf /var/lib/apt/lists/*
COPY linux/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
ENV QT_QPA_PLATFORM=offscreen
WORKDIR /project
